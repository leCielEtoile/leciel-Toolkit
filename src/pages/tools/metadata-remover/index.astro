---
import ToolLayout from '@/layouts/ToolLayout.astro'
import MetadataRemover from '@/components/MetadataRemover.svelte'
import ToolInfo from '@/components/ToolInfo.astro'
---

<ToolLayout
  title="画像メタデータ削除ツール"
  description="PNG・JPEG画像からEXIF、XMP、IPTC等のメタデータを完全に削除するツール"
>
  <MetadataRemover client:load />

  <ToolInfo
    features={[
      'JPEG・PNG 画像から EXIF・XMP・IPTC などのメタデータを完全に削除',
      'GPS 位置情報・撮影日時・カメラ機種情報などのプライベートデータを除去',
      '複数ファイルを一括処理してまとめてダウンロード',
      '画質を劣化させずにメタデータのみを削除',
    ]}
    steps={[
      '削除したい画像ファイル（JPEG / PNG）をドロップゾーンにドラッグ＆ドロップ、またはクリックして選択します。',
      'ファイルが自動的にメタデータ削除処理されます。',
      '処理完了後、各ファイルのダウンロードボタンから個別に保存するか、「全てダウンロード」でまとめて保存します。',
    ]}
  />
</ToolLayout>
