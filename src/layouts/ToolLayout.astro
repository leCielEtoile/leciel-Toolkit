---
import '@/styles/global.css'
import Header from '@/components/Header.svelte'

interface Props {
  title: string
  description?: string
  showHome?: boolean
}

const { title, description = '', showHome = true } = Astro.props
const pageTitle = `${title} | leciel ToolKit`
---

<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{pageTitle}</title>
  {description && <meta name="description" content={description} />}
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" crossorigin="anonymous" />
  <!-- FOUC 防止: ページ表示前にダークモード適用 -->
  <script is:inline>
    (function () {
      const stored = localStorage.getItem('darkMode')
      const systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches
      if (stored === 'enabled' || (!stored && systemDark)) {
        document.documentElement.classList.add('dark')
      }
    })()
  </script>
</head>
<body class="flex flex-col min-h-screen bg-[var(--background)] text-[var(--text)]">
  <Header title={title} showHome={showHome} client:load />

  <main class="flex-1 w-full max-w-4xl mx-auto px-4 sm:px-6 pt-10 pb-16 flex flex-col gap-10">
    <slot />
  </main>

  <footer class="w-full py-4 text-center text-sm text-[var(--text-muted)] bg-[var(--surface-variant)] border-t border-[var(--outline-variant)] transition-colors duration-300">
    <p>&copy; 2026 leciel ToolKit</p>
  </footer>
</body>
</html>
